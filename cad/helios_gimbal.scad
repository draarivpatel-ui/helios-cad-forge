// Helios-6 parametric gimbal. Generated by engine.js exportScad().
// Units: millimetres and degrees. Z is up, Y is north.
// Set part to base, wheel, yoke, array or assembly to render one body.

module_mm = 1.5;
teeth = 24;
wall = 3;
face_width = 6;
bore_d = 8;
pressure_angle = 20;
print_tolerance = 0.1;
panel_w = 48;
panel_d = 36;
panel_t = 3;
flank_steps = 4;
base_segments = 96;
cable_hole_r = 4;
pivot_bore = 3;
latitude = 38.9;
declination = 23.44;
explode = 0;
azimuth = 180;
elevation = 90 - abs(latitude - declination);
part = "assembly";

// Gear geometry (spur-profile approximation of the worm wheel).
function inv(a) = tan(a) - a * PI / 180;
rp = module_mm * teeth / 2;
rb = rp * cos(pressure_angle);
ra = rp + module_mm;
rf = rp - 1.25 * module_mm;
backlash = print_tolerance + 0.04 * module_mm;
half_pitch = PI / (2 * teeth) - backlash / (4 * rp);
rs = max(rb, rf);
function half_angle(r) = half_pitch + inv(pressure_angle) - inv(acos(min(1, rb / r)));
function pt(r, a) = [r * cos(a * 180 / PI), r * sin(a * 180 / PI)];
function flank_r(i) = rs + (ra - rs) * i / flank_steps;
function tooth(k) = concat(
    [for (i = [0 : flank_steps]) pt(flank_r(i), 2 * PI * k / teeth - half_angle(flank_r(i)))],
    [for (i = [flank_steps : -1 : 0]) pt(flank_r(i), 2 * PI * k / teeth + half_angle(flank_r(i)))],
    [pt(rf, 2 * PI * k / teeth + PI / teeth)]
);
function gear_points() = [for (k = [0 : teeth - 1]) each tooth(k)];

// Stack dimensions.
base_r = max(ra + wall + 2, 22);
base_h = 12 + 2 * wall;
t_arm = wall + 1.5;
yoke_gap = panel_w + 2;
yoke_w = yoke_gap + 2 * t_arm;
yoke_depth = 28;
z_pivot = wall + panel_d / 2 + 3;
yoke_h = z_pivot + 6;
chamfer = min(1.5, t_arm / 2);
wheel_z = base_h + 1;
yoke_z = wheel_z + face_width;
pcb_w = max(8, panel_w - 8);
pcb_d = max(8, panel_d - 10);
pcb_t = 1.6;

module base() {
    rotate_extrude($fn = base_segments)
        polygon([[cable_hole_r, 0], [base_r, 0], [base_r, base_h],
                 [base_r - wall, base_h], [base_r - wall, wall], [cable_hole_r, wall]]);
}

module wheel() {
    difference() {
        linear_extrude(height = face_width) polygon(gear_points());
        translate([0, 0, -1]) cylinder(d = bore_d, h = face_width + 2, $fn = 96);
    }
}

module yoke_body() {
    translate([0, yoke_depth, 0]) rotate([90, 0, 0])
        linear_extrude(height = yoke_depth)
            polygon([[0, 0], [yoke_w, 0], [yoke_w, yoke_h - chamfer], [yoke_w - chamfer, yoke_h],
                     [yoke_w - t_arm, yoke_h], [yoke_w - t_arm, wall], [t_arm, wall],
                     [t_arm, yoke_h], [chamfer, yoke_h], [0, yoke_h - chamfer]]);
}

module yoke() {
    difference() {
        yoke_body();
        if (pivot_bore > 0)
            translate([-1, yoke_depth / 2, z_pivot]) rotate([0, 90, 0])
                cylinder(d = pivot_bore, h = yoke_w + 2, $fn = 48);
    }
}

module array() {
    translate([-panel_w / 2, -panel_d / 2, -panel_t / 2]) cube([panel_w, panel_d, panel_t]);
    translate([-pcb_w / 2, -pcb_d / 2, -panel_t / 2 - pcb_t]) cube([pcb_w, pcb_d, pcb_t]);
    for (sx = [-1, 1], sy = [-1, 1])
        translate([sx * (panel_w / 2 - 6) - 2, sy * (panel_d / 2 - 6) - 2, panel_t / 2]) cube([4, 4, 2]);
}

module assembly() {
    e = explode * 45;
    base();
    translate([0, 0, wheel_z + e]) rotate([0, 0, -azimuth]) wheel();
    translate([0, 0, yoke_z + 2 * e]) rotate([0, 0, -azimuth])
        translate([-yoke_w / 2, -yoke_depth / 2, 0]) yoke();
    translate([0, 0, yoke_z + z_pivot + 3 * e]) rotate([0, 0, -azimuth])
        rotate([-(90 - elevation), 0, 0]) array();
}

if (part == "base") base();
else if (part == "wheel") wheel();
else if (part == "yoke") yoke();
else if (part == "array") array();
else assembly();
